<canvas
  id="dot-grid"
  aria-hidden="true"
  class="pointer-events-none fixed inset-0 -z-10 h-full w-full"
></canvas>

<style>
  /* No-JS fallback: the canvas bitmap paints over its own CSS background once the script runs.
     Keep <body> without a background, or it hides this canvas (z-index -10). */
  #dot-grid {
    background-image: radial-gradient(var(--dot) 1px, transparent 1px);
    background-size: var(--dot-gap) var(--dot-gap);
  }
</style>

<script>
  const RADIUS = 960; // cursor reach, px
  const PUSH = 16; // max displacement right under the cursor, px
  const EASE = 0.12; // share of the remaining distance each dot moves per frame
  const GLOW = 150; // radius where dots brighten around the cursor, px
  const GLOW_HOLD = 0.25; // share of GLOW kept at full brightness before it fades
  const LEVELS = 12; // brightness steps, one fill call each
  const STAR_SHARE = 0.02; // share of dots twinkling at any moment
  const STAR_MIN = 3000, STAR_MAX = 7000; // one fade in + out, ms
  const EGG_SIZE = 4.5; // ✦ tip-to-centre, px

  const canvas = document.getElementById("dot-grid") as HTMLCanvasElement;
  const ctx = canvas.getContext("2d")!;
  const root = document.documentElement;
  const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const followCursor = !reduceMotion && !matchMedia("(hover: none)").matches;
  const twinkle = !reduceMotion;

  type Star = { i: number; start: number; dur: number; peak: number };

  let w = 0, h = 0, cols = 0, rows = 0;
  let gap = 32, bg = "", dot = "", glow = "";
  let offsets = new Float32Array(0); // [x, y] offset per dot
  let shine = new Float32Array(0); // twinkle brightness per dot, 0–1
  let stars: Star[] = [];
  let mx = -1e4, my = -1e4;
  let frame = 0;
  // Easter egg: one dot drawn as ✦. Its spot is kept as a share of the grid, not an index,
  // so it stays put when a mobile URL bar fires resize.
  const eggX = Math.random(), eggY = Math.random();
  let egg = -1;

  function readTheme() {
    const s = getComputedStyle(root);
    bg = s.getPropertyValue("--bg").trim();
    dot = s.getPropertyValue("--dot").trim();
    glow = s.getPropertyValue("--dot-glow").trim();
    gap = parseFloat(s.getPropertyValue("--dot-gap")) || 32;
  }

  function resize() {
    const dpr = window.devicePixelRatio || 1;
    w = innerWidth;
    h = innerHeight;
    canvas.width = w * dpr;
    canvas.height = h * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    cols = Math.ceil(w / gap) + 1;
    rows = Math.ceil(h / gap) + 1;
    offsets = new Float32Array(cols * rows * 2);
    shine = new Float32Array(cols * rows);
    // The grid has an extra row and column past the edge; floor(w / gap) counts only on-screen dots.
    egg = Math.floor(eggY * Math.floor(h / gap)) * cols + Math.floor(eggX * Math.floor(w / gap));
    const now = performance.now();
    stars = twinkle
      ? Array.from({ length: Math.ceil(cols * rows * STAR_SHARE) }, () => {
          const s = spawn({ i: 0, start: 0, dur: 0, peak: 0 }, now);
          // Start partway through so the stars don't all fade in together.
          s.start -= Math.random() * s.dur;
          return s;
        })
      : [];
  }

  function spawn(s: Star, now: number) {
    s.i = Math.floor(Math.random() * shine.length);
    s.start = now;
    s.dur = STAR_MIN + Math.random() * (STAR_MAX - STAR_MIN);
    s.peak = 0.4 + Math.random() * 0.6;
    return s;
  }

  function updateStars(now: number) {
    shine.fill(0);
    for (const s of stars) {
      if (now - s.start >= s.dur) spawn(s, now);
      const b = Math.sin((Math.PI * (now - s.start)) / s.dur) * s.peak;
      shine[s.i] = Math.max(shine[s.i], b);
    }
  }

  // Quadratic curves pulled to the centre give the concave sides of ✦.
  function addDot(p: CanvasPath, x: number, y: number, star: boolean) {
    if (!star) {
      p.moveTo(x + 1, y);
      p.arc(x, y, 1, 0, Math.PI * 2);
      return;
    }
    const s = EGG_SIZE;
    p.moveTo(x, y - s);
    p.quadraticCurveTo(x, y, x + s, y);
    p.quadraticCurveTo(x, y, x, y + s);
    p.quadraticCurveTo(x, y, x - s, y);
    p.quadraticCurveTo(x, y, x, y - s);
    p.closePath();
  }

  function glowAt(d: number) {
    return d >= GLOW ? 0 : Math.min(1, (1 - d / GLOW) / (1 - GLOW_HOLD));
  }

  // Returns true while any dot is still easing toward its target.
  function draw() {
    updateStars(performance.now());
    // Fill the background so the static CSS fallback dots stay hidden.
    ctx.fillStyle = bg;
    ctx.fillRect(0, 0, w, h);
    ctx.fillStyle = dot;
    ctx.beginPath();
    // Dots are bucketed by brightness instead of painted with a gradient,
    // so a star inside the cursor glow keeps the brighter of the two.
    const levels = Array.from({ length: LEVELS }, () => new Path2D());
    let moving = false;
    for (let r = 0, i = 0; r < rows; r++) {
      for (let c = 0; c < cols; c++, i += 2) {
        // Centred in each tile to line up with the CSS radial-gradient fallback.
        const x = c * gap + gap / 2;
        const y = r * gap + gap / 2;
        const dx = x - mx;
        const dy = y - my;
        const d = Math.hypot(dx, dy);
        let tx = 0, ty = 0;
        if (d > 0 && d < RADIUS) {
          const f = (1 - d / RADIUS) ** 2 * PUSH;
          tx = (dx / d) * f;
          ty = (dy / d) * f;
        }
        const ox = (offsets[i] += (tx - offsets[i]) * EASE);
        const oy = (offsets[i + 1] += (ty - offsets[i + 1]) * EASE);
        if (Math.abs(tx - ox) > 0.05 || Math.abs(ty - oy) > 0.05) moving = true;
        const px = x + ox;
        const py = y + oy;
        const star = i / 2 === egg;
        addDot(ctx, px, py, star);
        const b = Math.max(shine[i / 2], glowAt(Math.hypot(px - mx, py - my)));
        const k = Math.ceil(b * LEVELS);
        if (k > 0) addDot(levels[k - 1], px, py, star);
      }
    }
    ctx.fill();
    ctx.fillStyle = glow;
    for (let k = 0; k < LEVELS; k++) {
      ctx.globalAlpha = (k + 1) / LEVELS;
      ctx.fill(levels[k]);
    }
    ctx.globalAlpha = 1;
    return moving;
  }

  // Without twinkle, the loop stops once dots settle, so an idle page costs nothing.
  function tick() {
    frame = draw() || twinkle ? requestAnimationFrame(tick) : 0;
  }
  function start() {
    if (!frame) frame = requestAnimationFrame(tick);
  }

  readTheme();
  resize();
  draw();
  if (twinkle) start();

  addEventListener("resize", () => {
    resize();
    draw();
  });

  new MutationObserver(() => {
    readTheme();
    draw();
  }).observe(root, { attributes: true, attributeFilter: ["class"] });

  if (followCursor) {
    addEventListener(
      "pointermove",
      (e) => {
        mx = e.clientX;
        my = e.clientY;
        start();
      },
      { passive: true }
    );
    addEventListener("pointerout", (e) => {
      if (e.relatedTarget) return;
      mx = my = -1e4;
      start();
    });
  }
</script>
