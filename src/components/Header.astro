---
import Logo from "./Logo.astro";
import MobileNav from "./MobileNav.tsx";
import { NAV, SITE } from "../config";

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? pathname === "/" : pathname.startsWith(href);
---

<!-- pointer-events-none: the transparent gutter around the pill must not block clicks on content scrolling under it. -->
<header class="pointer-events-none sticky top-3 z-50 mx-auto mt-3 w-full max-w-5xl px-3">
  <div
    class="pointer-events-auto flex items-center justify-between rounded-2xl border border-border bg-surface px-4 py-2 shadow-xl shadow-black/15"
  >
    <a href="/" class="flex items-center gap-3" aria-label={SITE.name}>
      <Logo class="h-8 w-auto" />
      <span class="text-lg tracking-wide font-display font-medium">
        {SITE.shortName}
      </span>
    </a>

    <div class="flex items-center gap-2">
      <nav aria-label="Main" class="mr-2 hidden items-center gap-1 md:flex">
        {
          NAV.map((item) => (
            <a
              href={item.href}
              aria-current={isActive(item.href) ? "page" : undefined}
              class:list={[
                "rounded-md px-3 py-2 text-sm tracking-wide transition-colors font-semibold",
                isActive(item.href)
                  ? "text-brand"
                  : "text-fg-muted hover:text-fg",
              ]}
            >
              {item.label}
            </a>
          ))
        }
      </nav>
      <MobileNav nav={NAV} pathname={pathname} client:load />
    </div>
  </div>
</header>
