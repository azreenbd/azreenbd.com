---
interface Props {
  href: string;
  title: string;
  description: string;
  tags?: string[];
  cover?: string;
  year?: number;
  // 2 on pages with no h2 above the grid, so heading levels don't skip.
  headingLevel?: 2 | 3;
}
const { href, title, description, tags = [], cover, year, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as const;
// The whole card is one link; point its name and description at the parts, so screen readers don't read every tag.
const id = `card${href.replace(/[^a-z0-9]+/gi, "-")}`;
---

<a
  href={href}
  aria-labelledby={`${id}-title`}
  aria-describedby={`${id}-desc`}
  class="group flex flex-col overflow-hidden rounded-xl border border-border bg-surface transition-all highlight:-translate-y-1 highlight:bg-brand highlight:shadow-[0_4px_0_0_color-mix(in_srgb,var(--color-brand),black_40%)]"
>
  <div class="relative aspect-video overflow-hidden bg-brand/20">
    {
      cover && (
        <img
          src={cover}
          alt=""
          loading="lazy"
          class="h-full w-full object-cover"
        />
      )
    }
  </div>
  <div class="flex flex-1 flex-col p-5">
    <div class="flex items-baseline justify-between gap-2">
      <Heading id={`${id}-title`} class="text-xl transition-colors group-highlight:text-white">{title}</Heading>
      {year && <span class="text-sm text-fg-muted transition-colors group-highlight:text-white/80">{year}</span>}
    </div>
    <p id={`${id}-desc`} class="mt-2 flex-1 text-sm text-fg-muted transition-colors group-highlight:text-white/80">{description}</p>
    {
      tags.length > 0 && (
        <ul class="mt-4 flex flex-wrap gap-2">
          {tags.map((tag) => (
            <li class="rounded-full border border-border px-2.5 py-0.5 text-xs text-fg-muted transition-colors group-highlight:border-white/40 group-highlight:text-white/80">
              {tag}
            </li>
          ))}
        </ul>
      )
    }
  </div>
</a>
